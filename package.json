{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"404.css\" \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test:migration": "playwright test --config=playwright.migration.config.js",
    "test:migration:unit": "playwright test tests/migration/unit --config=playwright.migration.config.js --reporter=line",
    "test:migration:report": "playwright show-report playwright-report/migration",
    "test:comparison": "playwright test --config=playwright.comparison.config.js",
    "test:comparison:open": "open comparison-report/index.html",
    "comparison:ui": "node tests/migration/launcher/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/eslint-parser": "7.29.7",
    "@playwright/test": "^1.62.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0"
  }
}
